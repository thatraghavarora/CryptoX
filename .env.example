# WhatsApp Configuration
META_WA_ACCESS_TOKEN=your_meta_access_token
WA_BUSSINESS_PHONE_NUMBER=your_whatsapp_business_number
META_WA_WABA_ID=your_waba_id
META_WA_SENDER_PHONE_NUMBER_ID=your_phone_number_id
META_WA_VERIFY_TOKEN=your_verify_token
PROD_URL=your_vercel_deployment_url

# Encryption & Security
ENCRYPTION_KEY=generate_with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRIVATE_KEY=your_private_key_here
OPERATOR_PRIVATE_KEY=your_funded_wallet_private_key_for_gas

# Multi-Chain Configuration
DEFAULT_CHAIN=hela
SUPPORTED_CHAINS=hela,sepolia,mumbai,bsc_testnet,base_sepolia,arbitrum_sepolia,avalanche_fuji

# Hela Chain (Original)
HELA_RPC_URL=https://testnet-rpc.helachain.com
HELA_CONTRACT_ADDRESS=your_deployed_contract_address
CRYPTOX_CONTRACT_ADDRESS=your_deployed_contract_address

# Ethereum Sepolia Testnet
ETH_SEPOLIA_RPC=https://rpc.ankr.com/eth_sepolia
SEPOLIA_CONTRACT_ADDRESS=your_deployed_contract_address

# Polygon Mumbai Testnet
POLYGON_MUMBAI_RPC=https://rpc.ankr.com/polygon_mumbai
MUMBAI_CONTRACT_ADDRESS=your_deployed_contract_address

# BSC Testnet
BSC_TESTNET_RPC=https://rpc.ankr.com/bsc_testnet
BSC_TESTNET_CONTRACT_ADDRESS=your_deployed_contract_address

# Base Sepolia Testnet
BASE_SEPOLIA_RPC=https://rpc.ankr.com/base_sepolia
BASE_SEPOLIA_CONTRACT_ADDRESS=your_deployed_contract_address

# Arbitrum Sepolia Testnet
ARBITRUM_SEPOLIA_RPC=https://rpc.ankr.com/arbitrum_sepolia
ARBITRUM_SEPOLIA_CONTRACT_ADDRESS=your_deployed_contract_address

# Avalanche Fuji Testnet
AVALANCHE_FUJI_RPC=https://rpc.ankr.com/avalanche_fuji
AVALANCHE_FUJI_CONTRACT_ADDRESS=your_deployed_contract_address

# Testnet Wallet Generation
TESTNET_MNEMONIC=test test test test test test test test test test test junk
AUTO_FUND_WALLETS=false